{
  "name": "observability-frontend-react",
  "version": "1.0.0",
  "type": "module",
  "description": "Optikk Observability Platform - React Frontend",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "deploy:firebase": "vite build && npx firebase-tools deploy --only hosting",
    "ci": "yarn type-check && yarn lint && yarn check:colors && yarn check:dupes && yarn build",
    "preview": "vite preview",
    "check:colors": "node scripts/check-theme-colors.mjs",
    "check:dupes": "node scripts/check-duplication.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit"
  },
