# Dockerfile for deploying the frontend marketing website on GCP Cloud Run
# Stage 1: Build the React app
FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable

# Copy package files
COPY package.json yarn.lock ./

# Install dependencies
RUN yarn install --frozen-lockfile

# Copy source code
COPY . .

# Build the app using Vite directly (skipping strict compiler checks that would fail on other parts of the codebase)
RUN npx vite build

# Stage 2: Serve with NGINX
FROM nginx:alpine

# Copy built files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config
COPY nginx.cloudrun.conf /etc/nginx/conf.d/default.conf

# Expose port 8080
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
